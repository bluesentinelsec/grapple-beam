# Build trees
build/
dist/
log.md
cmake-build-*/
out/
install/

# Compilation database (regenerated by make debug)
compile_commands.json

# ctags index (regenerated by make tags)
tags
TAGS
.tags
# ...except the one the generator writes and the SDK ships. The negation
# has to come last: gitignore takes the final matching pattern, and on a
# case-insensitive filesystem `TAGS` matches `tags` too — so a negation
# placed above it still left the file ignored, and locally there was
# nothing to see but a file that quietly never got committed.
!bindings/generated/editor/tags

# Doxygen
docs/html/
docs/latex/
docs/xml/
docs/rtf/
docs/man/

# IDE / editor
.idea/
# Keep shared VS Code project files; ignore only local/unshared editor state.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
.DS_Store
CMakeUserPresets.json

# Python / tooling
__pycache__/
*.pyc
.venv/
venv/

# Coverage / sanitizers
*.gcda
*.gcno
*.profraw
*.profdata
default.profraw

# Package / install leftovers
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
*.pdb

# Android / Gradle
android/.gradle/
android/local.properties
local.properties
.cxx/
.cache/
site/
