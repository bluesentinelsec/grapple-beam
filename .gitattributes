* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
# Generated binding files are always LF so the freshness check compares
# byte-identical content on every platform.
bindings/generated/* text eol=lf
cpp/include/grapple/gen/* text eol=lf
# Same for the embedded shaders and the header generated from them.
light/shaders/* text eol=lf
light/src/light_shaders.h text eol=lf
